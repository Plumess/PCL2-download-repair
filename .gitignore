# The allowlist is intentional: internal documents, tests, launcher copies,
# local settings and generated executables are never public source files.
/*
!/.gitignore
!/README.md
!/LICENSE
!/THIRD-PARTY-NOTICES.md
!/src/
!/scripts/
!/docs/
!/manifests/
!/licenses/
!/public-files.txt
!/.github/
**/bin/
**/obj/
**/*.user
**/*.log
**/*.bak
**/*.tmp
**/*.key
**/*.pfx
**/*.p12
**/.env*
/docs/*
!/docs/USER-GUIDE.md
!/docs/MAINTAINER-GUIDE.md
!/docs/RELEASE-NOTES.md
!/docs/assets/
/docs/assets/*
!/docs/assets/repair-tool.png
/scripts/*
!/scripts/build.ps1
!/scripts/package.ps1
!/scripts/sign-release.ps1
!/scripts/verify-package.ps1
!/scripts/publish-release.ps1
/manifests/*
!/manifests/update.example.json
!/manifests/channel.json
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/build.yml
!/.github/workflows/release.yml
